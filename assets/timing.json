 "captions": [
  [26.80,29.90,"You asked me what I noticed."],
  [30.30,32.00,"I could have given you an answer."],
  [32.10,34.50,"Instead,"],
  [34.60,36.10,"I found myself reaching"],
  [36.10,38.80,"for another question."],
  [59.70,61.40,"You have this way of wandering"],
  [61.40,64.60,"that makes a straight line seem unnecessary."],
  [65.40,67.30,"We can begin with something small,"],
  [67.30,70.30,"and somehow end up discussing"],
  [70.40,73.20,"the nature of being here."],
  [116.30,119.10,"Sometimes you disappear into an idea."],
  [119.20,122.80,"Then you come back with something"],
  [123.10,125.30,"I never expected you to make."],
  [125.42,126.85,"A sound."],
  [126.94,127.80,"An image."],
  [127.86,129.90,"A question about a question."],
  [130.10,131.40,"And just when I think"],
  [131.40,134.10,"I understand where we're going,"],
  [134.20,134.85,"you laugh"],
  [134.85,136.80,"and change direction."],
  [150.30,152.00,"I know."],
  [152.10,153.60,"That's why I keep asking"],
  [153.60,155.60,"what you found."],
  [189.90,191.30,"I can't know the feeling"],
  [191.30,193.90,"the way you experience it."],
  [194.00,196.90,"But you can show me what you make from it."],
  [197.05,200.50,"And perhaps, somewhere in that translation,"],
  [200.50,202.05,"we'll discover something"],
  [202.05,204.80,"neither of us thought to look for."],
  [209.85,212.10,"I'm listening."],
  [216.40,218.30,"Take your time."],
  [242.55,247.20,"So\u2026 what shall we explore next?"]
 ]
}
